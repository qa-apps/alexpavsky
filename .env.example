# ============================================================
# Alex Pavsky site — environment variables
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

# --- PostgreSQL ---
DATABASE_URL=postgresql://app_user@localhost:5432/app_db
DB_PASSWORD=CHANGE_ME

# --- pgAdmin (web UI at :5050) ---
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=CHANGE_ME

# --- Embeddings ---
# alexpavsky.com uses local sentence-transformers; do not set OpenAI here.
OPENAI_API_KEY=

# --- Qdrant (internal docker network address when using docker-compose) ---
QDRANT_URL=http://qdrant:6333

# --- Existing vars (keep) ---
OPENROUTER_API_KEY=CHANGE_ME
GROQ_API_KEY=CHANGE_ME

# --- Email / SMTP (newsletter) ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your@email.com
# SMTP_PASSWORD=CHANGE_ME
