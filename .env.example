# ============================================================
# Alex Pavsky site — environment variables
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

# --- PostgreSQL ---
DATABASE_URL=postgresql://app_user@localhost:5432/app_db
DB_PASSWORD=CHANGE_ME

# --- pgAdmin (web UI at :5050) ---
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=CHANGE_ME

# --- Embeddings ---
# alexpavsky.com uses local sentence-transformers; do not set OpenAI here.
OPENAI_API_KEY=

# --- Qdrant (internal docker network address when using docker-compose) ---
QDRANT_URL=http://qdrant:6333

# --- Existing vars (keep) ---
OPENROUTER_API_KEY=CHANGE_ME
# Use OpenRouter account credits for voice/RAG when free tiers throttle (default on).
# Same API key works for :free and paid models — credits only bill non-:free models.
OPENROUTER_USE_CREDITS=1
GROQ_API_KEY=CHANGE_ME

# --- Multi-agent runtime (chat + voice) ---
# AGENT_RUNTIME=1
# RAG_API_URL=https://alexpavsky.com
# MIN_RAG_SCORE=0.20
# CHAT_MIN_RAG_SCORE=0.18
# AGENT_RAG_SKIP_METRICS=0
# AGENT_OBS_LOG=1

# --- Langfuse (AI chat assistant traces) ---
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
# AGENT_OBS_DISABLE_LANGFUSE=0

# --- LangWatch (AI voice assistant traces; also set on voice-agent host) ---
# LANGWATCH_API_KEY=
# AGENT_OBS_DISABLE_LANGWATCH=0

# --- Email / SMTP (newsletter) ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your@email.com
# SMTP_PASSWORD=CHANGE_ME
